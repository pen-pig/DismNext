<Window x:Class="DismPlusNext.UI.OfflineWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="离线映像服务" Height="460" Width="640" WindowStartupLocation="CenterOwner" Background="{StaticResource BgDarkBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="离线映像服务（Dism++ 招牌功能）" FontSize="16" FontWeight="Bold" Foreground="{StaticResource FgTextBrush}" Margin="0,0,0,8"/>
        <TextBlock Grid.Row="0" Text="挂载 WIM/ESD 后，空间回收与系统优化将直接作用于映像（需管理员）。" FontSize="11" Foreground="{StaticResource FgMutedBrush}" HorizontalAlignment="Right"/>

        <Grid Grid.Row="1" Margin="0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TxtWim" Grid.Column="0" Padding="6" Background="{StaticResource BgPanelBrush}" Foreground="{StaticResource FgTextBrush}" BorderBrush="{StaticResource BgControlBrush}"/>
            <Button Grid.Column="1" Content="浏览..." Click="BtnBrowse_Click" Padding="10,4" Margin="6,0,0,0"/>
        </Grid>

        <Grid Grid.Row="2" Margin="0,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                <Button Content="查看映像信息" Click="BtnInfo_Click" Padding="10,4"/>
                <TextBlock x:Name="TxtInfoHint" Text="" Foreground="{StaticResource FgMutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </StackPanel>
            <DataGrid x:Name="GridIndices" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" Background="{StaticResource BgPanelBrush}"
                      Foreground="{StaticResource FgTextBrush}" BorderBrush="{StaticResource BgControlBrush}" RowBackground="{StaticResource BgPanelBrush}"
                      AlternatingRowBackground="{StaticResource BgControlBrush}" SelectionMode="Single" HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="索引" Binding="{Binding Index}" Width="50"/>
                    <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="版本" Binding="{Binding Version}" Width="90"/>
                    <DataGridTextColumn Header="架构" Binding="{Binding Architecture}" Width="80"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <Grid Grid.Row="3" Margin="0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="挂载目录：" VerticalAlignment="Center" Foreground="{StaticResource FgTextBrush}" Margin="0,0,8,0"/>
            <TextBox x:Name="TxtMount" Grid.Column="1" Padding="6" Background="{StaticResource BgPanelBrush}" Foreground="{StaticResource FgTextBrush}" BorderBrush="{StaticResource BgControlBrush}"/>
        </Grid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="BtnMount" Content="挂载(可写)" Click="BtnMount_Click" Padding="14,6" Background="{StaticResource AccentBrush}" BorderBrush="{StaticResource AccentBrush}" FontWeight="Bold"/>
            <Button x:Name="BtnUnmount" Content="卸载并提交" Click="BtnUnmount_Click" Padding="14,6" Margin="8,0,0,0" IsEnabled="False"/>
            <Button Content="取消" Click="BtnCancel_Click" Padding="14,6" Margin="8,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
