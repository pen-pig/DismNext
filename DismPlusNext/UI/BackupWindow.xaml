<Window x:Class="DismPlusNext.UI.BackupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="备份还原 - Dism-Plus-Next" Height="580" Width="640" FontSize="13"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BgAppBrush}">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" Text="系统备份与还原（基于 DISM，需管理员权限）" FontSize="15" FontWeight="Bold" Margin="0,0,0,10" Foreground="{StaticResource FgTextBrush}"/>
        <TextBox x:Name="TxtLog" DockPanel.Dock="Bottom" Height="110" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                 FontFamily="Consolas, monospace" FontSize="11" BorderThickness="1" BorderBrush="#3F3F46" Margin="0,10,0,0"/>
        <ScrollViewer DockPanel.Dock="Top">
            <StackPanel>
                <GroupBox Header="创建系统备份（捕获当前系统为 WIM 映像）" Padding="8" BorderBrush="#3F3F46">
                    <StackPanel>
                        <DockPanel Margin="0,2">
                            <TextBlock Text="映像路径：" Width="70" VerticalAlignment="Center" Foreground="{StaticResource FgTextBrush}"/>
                            <TextBox x:Name="TxtImgPath" Text="D:\SystemBackup.wim"/>
                        </DockPanel>
                        <DockPanel Margin="0,2">
                            <TextBlock Text="映像名称：" Width="70" VerticalAlignment="Center" Foreground="{StaticResource FgTextBrush}"/>
                            <TextBox x:Name="TxtName" Text="DismPlusNext 备份"/>
                        </DockPanel>
                        <DockPanel Margin="0,2">
                            <TextBlock Text="捕获目录：" Width="70" VerticalAlignment="Center" Foreground="{StaticResource FgTextBrush}"/>
                            <TextBox x:Name="TxtCaptureDir" Text="C:\"/>
                        </DockPanel>
                        <Button x:Name="BtnBackup" Content="开始备份" HorizontalAlignment="Left" Margin="0,6,0,0" Padding="14,4" Click="BtnBackup_Click"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="从备份还原（会覆盖目标驱动器，慎用）" Padding="8" BorderBrush="#3F3F46" Margin="0,8,0,0">
                    <StackPanel>
                        <DockPanel Margin="0,2">
                            <TextBlock Text="映像路径：" Width="70" VerticalAlignment="Center" Foreground="{StaticResource FgTextBrush}"/>
                            <TextBox x:Name="TxtRestoreImg" Text="D:\SystemBackup.wim"/>
                        </DockPanel>
                        <DockPanel Margin="0,2">
                            <TextBlock Text="索引：" Width="70" VerticalAlignment="Center" Foreground="{StaticResource FgTextBrush}"/>
                            <TextBox x:Name="TxtIndex" Text="1" Width="60"/>
                        </DockPanel>
                        <DockPanel Margin="0,2">
                            <TextBlock Text="目标目录：" Width="70" VerticalAlignment="Center" Foreground="{StaticResource FgTextBrush}"/>
                            <TextBox x:Name="TxtApplyDir" Text="C:\"/>
                        </DockPanel>
                        <CheckBox x:Name="ChkConfirm" Content="我已知晓此操作会覆盖目标驱动器上的数据" Margin="0,6,0,4" Foreground="{StaticResource FgTextBrush}"/>
                        <Button x:Name="BtnRestore" Content="开始还原" HorizontalAlignment="Left" Padding="14,4" Click="BtnRestore_Click"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="查看映像信息" Padding="8" BorderBrush="#3F3F46" Margin="0,8,0,0">
                    <StackPanel>
                        <DockPanel Margin="0,2">
                            <TextBlock Text="映像路径：" Width="70" VerticalAlignment="Center" Foreground="{StaticResource FgTextBrush}"/>
                            <TextBox x:Name="TxtInfoImg" Text="D:\SystemBackup.wim"/>
                            <Button x:Name="BtnInfo" Content="查看" Margin="6,0,0,0" Padding="10,2" Click="BtnInfo_Click"/>
                        </DockPanel>
                        <ListBox x:Name="LstImages" Height="90" Margin="0,6,0,0" BorderThickness="1" BorderBrush="#3F3F46" Background="{StaticResource BgPanelBrush}" Foreground="{StaticResource FgTextBrush}"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
