<Window x:Class="DismPlusNext.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DismPlusNext.ViewModels"
        xmlns:local="clr-namespace:DismPlusNext"
        Title="Dism-Plus-Next" Height="720" Width="1100" FontSize="13">
    <Window.Resources>
        <CollectionViewSource x:Key="GroupedItems" Source="{Binding SelectedModule.Items}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Group"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>

        <DataTemplate x:Key="ModuleTemplate" DataType="vm:ModuleEntry">
            <StackPanel Orientation="Horizontal" Margin="6,8">
                <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Items.Count, StringFormat='  ({0})'}" Foreground="{StaticResource FgMutedBrush}" VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ItemTemplate" DataType="vm:ItemEntry">
            <Grid Margin="4,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked, Mode=TwoWay}" IsEnabled="{Binding IsApplicable}" VerticalAlignment="Center"
                          Visibility="{Binding IsInfo, Converter={x:Static local:Converters.InverseBoolToVisibility}}"/>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Status}" Foreground="{StaticResource FgMutedBrush}" FontSize="11" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding State, StringFormat='状态：{0}'}" Foreground="{StaticResource AccentBrush}" FontSize="11" TextWrapping="Wrap"
                               Visibility="{Binding State, Converter={x:Static local:Converters.StringToVisibility}}"/>
                    <ComboBox ItemsSource="{Binding OptionNames}" SelectedIndex="{Binding ComboIndex, Mode=TwoWay}"
                              Visibility="{Binding IsCombo, Converter={x:Static local:Converters.BoolToVisibility}}"
                              Margin="0,3,0,0" Width="220" HorizontalAlignment="Left" FontSize="12"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding FoundSizeText}" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,0,0"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <DockPanel LastChildFill="True">
        <!-- 顶部菜单栏 -->
        <Border DockPanel.Dock="Top" Background="{StaticResource BgPanelBrush}" Padding="8,6">
            <DockPanel>
                <TextBlock Text="Dism-Plus-Next" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}"/>
                <TextBlock Text="开源系统维护工具" Foreground="{StaticResource FgMutedBrush}" VerticalAlignment="Center" Margin="8,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <TextBlock Text="语言：" VerticalAlignment="Center" Foreground="{StaticResource FgMutedBrush}"/>
                    <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}" Width="120" Margin="4,0"/>
                    <Button Content="刷新" Command="{Binding RefreshCommand}" Padding="10,4"/>
                    <Button Content="备份还原" Click="OpenBackup" Padding="10,4" Margin="4,0,0,0"/>
                    <Button Content="离线映像服务" Click="OpenOffline" Padding="10,4" Margin="4,0,0,0"/>
                    <Button Content="卸载映像" Command="{Binding UnmountOfflineCommand}" Padding="10,4" Margin="4,0,0,0"
                            Visibility="{Binding IsOffline, Converter={x:Static local:Converters.BoolToVisibility}}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 离线映像模式横幅 -->
        <Border DockPanel.Dock="Top" Background="#2E4A2E" Padding="8,4" Visibility="{Binding IsOffline, Converter={x:Static local:Converters.BoolToVisibility}}">
            <TextBlock Foreground="#C8F0C8" FontSize="12">
                <Run Text="⛁ 离线映像模式："/>
                <Run Text="{Binding OfflineText}"/>
                <Run Text="　（空间回收 / 系统优化 将作用于该映像，完成后请『卸载映像』提交）"/>
            </TextBlock>
        </Border>

        <!-- 主体三栏 -->
        <Grid DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- 左：模块导航 -->
            <Border Grid.Column="0" Background="{StaticResource BgPanelBrush}" BorderBrush="#3F3F46" BorderThickness="0,0,1,0">
                <ListBox ItemsSource="{Binding Modules}" SelectedItem="{Binding SelectedModule, Mode=TwoWay}"
                         ItemTemplate="{StaticResource ModuleTemplate}" BorderThickness="0" Background="Transparent"/>
            </Border>

            <!-- 中：条目列表 -->
            <DockPanel Grid.Column="1" Margin="6">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                    <Button Content="扫描" Command="{Binding ScanCommand}" FontWeight="Bold"/>
                    <Button Content="{Binding ExecuteButtonText}" Command="{Binding ExecuteCommand}" FontWeight="Bold" Background="{StaticResource AccentBrush}" BorderBrush="{StaticResource AccentBrush}"/>
                    <Button Content="恢复默认" Command="{Binding RestoreDefaultsCommand}"
                            Visibility="{Binding ShowRestoreDefaults, Converter={x:Static local:Converters.BoolToVisibility}}"
                            FontWeight="Bold" Margin="4,0,0,0"/>
                    <TextBlock Text="{Binding TotalFoundText}" VerticalAlignment="Center" Margin="12,0" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Foreground="{StaticResource FgMutedBrush}" Margin="8,0"/>
                </StackPanel>
                <ListBox ItemsSource="{Binding Source={StaticResource GroupedItems}}"
                         SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                         ItemTemplate="{StaticResource ItemTemplate}" Margin="0,2">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BgHighlightBrush}" Padding="6,3" Margin="0,4,0,2">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{StaticResource FgTextBrush}"/>
                                    </Border>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                </ListBox>
            </DockPanel>

            <!-- 右：详情 -->
            <Border Grid.Column="2" Background="{StaticResource BgPanelBrush}" BorderBrush="#3F3F46" BorderThickness="1,0,0,0" Padding="10">
                <ScrollViewer>
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedItem.DisplayName, TargetNullValue='未选择条目'}" FontSize="15" FontWeight="Bold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding SelectedItem.Group, StringFormat='分组：{0}'}" Foreground="{StaticResource FgMutedBrush}" Margin="0,4"/>
                        <TextBlock Text="{Binding SelectedItem.Description}" TextWrapping="Wrap" Margin="0,8"/>
                        <TextBlock Text="{Binding SelectedItem.State, StringFormat='当前状态：{0}'}" Foreground="{StaticResource AccentBrush}"
                                   Visibility="{Binding SelectedItem.State, Converter={x:Static local:Converters.StringToVisibility}}" Margin="0,2"/>

                        <Border Background="{StaticResource WarnBgBrush}" BorderBrush="{StaticResource WarnFgBrush}" BorderThickness="1" Padding="6" Margin="0,6"
                                Visibility="{Binding SelectedItem.Warning, Converter={x:Static local:Converters.StringToVisibility}}">
                            <TextBlock Text="{Binding SelectedItem.Warning, StringFormat='⚠ {0}'}" TextWrapping="Wrap" Foreground="{StaticResource WarnFgBrush}"/>
                        </Border>

                        <TextBlock Text="发现内容 / 预览：" FontWeight="Bold" Margin="0,8,0,2"/>
                        <ListBox ItemsSource="{Binding SelectedItem.FoundTargets}" Height="160" BorderThickness="1" BorderBrush="#3F3F46"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 底部日志 -->
        <Grid DockPanel.Dock="Top" Height="150">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="日志" FontWeight="Bold" Margin="8,4" Foreground="{StaticResource FgMutedBrush}"/>
            <ListBox Grid.Row="1" ItemsSource="{Binding LogLines}" Margin="8,0,8,6"
                     FontFamily="Consolas, monospace" FontSize="11" BorderThickness="1" BorderBrush="#3F3F46"/>
        </Grid>

        <!-- 状态栏 -->
        <StatusBar DockPanel.Dock="Bottom" Background="{StaticResource BgPanelBrush}" Foreground="{StaticResource FgMutedBrush}">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock>
                    <Run Text="就绪"/>
                    <Run Text="{Binding IsBusy, StringFormat='（忙：{0}）'}"/>
                </TextBlock>
            </StatusBarItem>
        </StatusBar>
    </DockPanel>
</Window>
